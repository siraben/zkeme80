# Drive the full boot-time test suite headlessly.
#
# The suite is input-free except for one final "press any key to
# unload" pause, which the ENTER below dismisses.  Screenshots land
# next to this macro: the final tally and the menu it returns to.
#
# The test suite occupies the bottom-right menu entry.
set key_hold 0.25s
set key_delay 0.05s
key ON
wait 10s
key RIGHT
wait 0.3s
key DOWN
wait 0.3s
screenshot re/macros/MENU_BEFORE.png
# The first tap can be swallowed by KEY's flush-keys debounce; send a
# second one for the wait-key loop to catch.
key ENTER
wait 35s
screenshot re/macros/TALLY.png
# The suite is now parked in PAUSE with no key held, so KEY's
# flush-then-wait sequence observes this tap normally.
key ENTER
wait 3s
screenshot re/macros/BACK_AT_MENU.png
memdump re/macros/SUITE_RAM ram-logical
